# WAHA (WhatsApp HTTP API) Settings
# WAHA runs as a separate Docker container - see docker-compose.yml

# URL where WAHA is running (default: http://localhost:3001)
WAHA_API_URL=http://localhost:3001

# WAHA API key (set this to match WAHA_API_KEY in docker-compose.yml)
WAHA_API_KEY=your_api_key_here

# WAHA session name (default: "default")
WAHA_SESSION=default

# Server Configuration (optional)
PORT=3000
HOST=0.0.0.0

# Database path (optional)
DATABASE_PATH=./reminders.db
